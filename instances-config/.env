# Public (client-visible) configuration for the static SPA. None of these are
# secret — the OAuth credentials and the user's token live only in the session
# broker (see broker/). All are read at build time via $env/dynamic/public.
#
# Vite loads this file in every mode and overlays .env.<mode> on top, so this
# file holds the values shared by all deployments; anything that differs per
# deployment lives only in .env.development / .env.production / .env.staging /
# .env.testing. For builds, vite.config.js derives the mode from the checked-out
# branch (README §6). Other external services the app talks to are in services.json.
# Personal, uncommitted overrides go in .env.local or .env.<mode>.local.

# The template repo new campaigns are stamped from.
PUBLIC_TEMPLATE_OWNER=lets-encode
PUBLIC_TEMPLATE_REPO=campaign-template

# Which forge implementation to use (only 'github' is implemented today).
PUBLIC_FORGE=github
