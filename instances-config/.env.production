# Production overrides, loaded on top of .env when building from `main`.

# Topic stamped on every repo created here, used to build the listing.
PUBLIC_REPO_TOPIC=lets-encode-platform

# The mei-friend instance volunteers are handed off to for editing.
PUBLIC_MEI_FRIEND_URL=https://staging.mei-friend.mdw.ac.at

# Branch of lets-encode/lets-encode this instance deploys from, written as
# automation.ref into each new campaign's config.yaml.
PUBLIC_AUTOMATION_REF=main
